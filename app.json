{
  "expo": {
    "name": "EnjoyTennis",
    "slug": "enjoyTennis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tennisIcon.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.yourcompany.enjoytennis",
      "buildNumber": "1.0.0",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/tennisIcon.jpg",
        "backgroundColor": "#ffffff"
      },
      "package": "com.yourcompany.enjoytennis",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "11d0faac-673d-4ee8-8eab-7dd9f4441c9e"
      }
    },
    "owner": "royalsf",
    "plugins": [
      "expo-build-properties"
    ]
  }
}
