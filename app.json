{
  "expo": {
    "name": "EnjoyTennis",
    "slug": "enjoyTennis",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/tennisIcon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.royalsf.enjoytennis",
      "buildNumber": "1.0.0",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/tennisIcon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.royalsf.enjoytennis",
      "versionCode": 6,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "revenueCatApiKey": "goog_gIEHoBIRPXnrOPNhjdqSRwQQbPi",
      "eas": {
        "projectId": "11d0faac-673d-4ee8-8eab-7dd9f4441c9e"
      }
    },
    "owner": "royalsf",
    "plugins": [
      "expo-build-properties"
    ]
  }
}
