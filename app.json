{
  "expo": {
    "name": "테니스클럽",
    "slug": "enjoyTennis",
    "version": "1.1.4",
    "orientation": "portrait",
    "icon": "./assets/images/tennisIcon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "com.royalsf.enjoytennis",
      "buildNumber": "1.0.0",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/tennisIcon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.royalsf.enjoytennis",
      "versionCode": 15,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "revenueCatApiKey": "goog_gIEHoBIRPXnrOPNhjdqSRwQQbPi",
      "eas": {
        "projectId": "11d0faac-673d-4ee8-8eab-7dd9f4441c9e"
      }
    },
    "owner": "royalsf",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 35,
            "compileSdkVersion": 35,
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableHermes": true,
            "enableNewArchitecture": true,
            "enable16KbPageSize": true,
            "packagingOptions": {
              "jniLibs": {
                "useLegacyPackaging": false
              }
            },
            "ndkVersion": "28.0.12077973",
            "buildToolsVersion": "34.0.0",
            "enableR8": true,
            "gradleProperties": {
              "org.gradle.jvmargs": "-Xmx8g -XX:MaxMetaspaceSize=2048m -XX:+HeapDumpOnOutOfMemoryError",
              "org.gradle.daemon": "true",
              "org.gradle.parallel": "true",
              "android.lint.checkReleaseBuilds": "false"
            }
          }
        }
      ]
    ]
  }
}
